# Server Configuration
PORT=4000
NODE_ENV=development

# Object Storage Configuration
# -------------------------------------------------------------
# Active Provider: "s3" (Standard S3-compatible provider for MinIO, AWS S3, Cloudflare R2, Wasabi)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=media-store

# =============================================================
# OPTION 1: Local MinIO (CURRENT SETUP)
# =============================================================
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# =============================================================
# OPTION 2: AWS S3 (FUTURE PRODUCTION SETUP)
# To switch to AWS S3, simply comment OPTION 1 and uncomment OPTION 2:
# =============================================================
# STORAGE_ENDPOINT=
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your_aws_access_key_id
# STORAGE_SECRET_KEY=your_aws_secret_access_key
# STORAGE_FORCE_PATH_STYLE=false
