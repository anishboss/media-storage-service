{
  "name": "@dianomax/media-storage-service",
  "version": "1.0.5",
  "description": "Unified object storage library for files, images, and videos with MinIO and AWS S3 zero-code interoperability",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    }
  },
  "bin": {
    "media-storage-service": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "features",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "start": "node dist/bin/cli.js"
  },
  "keywords": [
    "minio",
    "aws-s3",
    "s3",
    "object-storage",
    "video-upload",
    "video-streaming",
    "image-upload",
    "presigned-url",
    "express"
  ],
  "author": "dianomax",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anishboss/media-storage-service.git"
  },
  "bugs": {
    "url": "https://github.com/anishboss/media-storage-service/issues"
  },
  "homepage": "https://github.com/anishboss/media-storage-service#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/lib-storage": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
