{
  "name": "media-storage-service",
  "version": "1.0.0",
  "description": "Unified object storage service for files, images, and videos with MinIO and AWS S3 zero-code interoperability",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/lib-storage": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
